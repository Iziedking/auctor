# Organisation API key created in KeeperHub Settings > API Keys.
KEEPERHUB_ACME_API_KEY=

# Override only if KeeperHub publishes a different MCP endpoint.
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Optional path to a JSON array of MCP tool calls. This file is gitignored.
KEEPERHUB_CALLS_FILE=scripts/keeperhub-calls.json
