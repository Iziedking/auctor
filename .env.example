# Runtime mode. Set to 1 for fixture-backed development without keys or network.
AUCTOR_MOCK_MODE=1

# PostgreSQL. Required for durable agents, executions, and spend accounting.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auctor

# KeeperHub organisation execution seam.
KEEPERHUB_ACME_API_KEY=
KEEPERHUB_ORG_ID=
KEEPERHUB_WALLET_ADDRESS=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
KEEPERHUB_CALLS_FILE=scripts/keeperhub-calls.json
KEEPERHUB_SIGNER_ENCRYPTION_KEY=

# Deterministic budget kill switches. Zero disables paid usage.
# This is a spending cap, not a stored balance. x402 charges settle from the
# provisioned KeeperHub agent wallet. Current verified providers request USDC
# on Base mainnet, so that wallet must hold a small Base USDC research balance.
RESEARCH_USD_PER_DAY=0
# Comma separated: name|category|endpoint. Categories: market, onchain, sentiment, news.
X402_RESEARCH_PROVIDERS=

# Optional keyed demo feeds. Keep server-only; these do not use x402.
MESSARI_API_KEY=
CRYPTONEWS_API_KEY=
COINDESK_API_KEY=
ADANOS_API_KEY=
FREE_CRYPTO_NEWS_ENDPOINT=https://cryptocurrency.cv/api/news

# LLM: anthropic, openrouter, or ollama.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org
AGENTROUTER_MODEL=claude-opus-4-8
AGENTROUTER_API_KEY=
LLM_CALLS_PER_DAY=100
OPENROUTER_API_KEY=

# Optional agent-memory sidecar.
AGENT_MEMORY_URL=http://127.0.0.1:4000
# Server-only identity. Never expose these values to browser code or API payloads.
AUCTOR_AGENT_ID=
AGENT_MEMORY_USER=
AGENT_MEMORY_PASSPHRASE=
AGENT_MEMORY_FOLDER=project-x

# Optional research and notification capabilities.
FIRECRAWL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SENDGRID_API_KEY=
DISCORD_WEBHOOK_URL=

SENDGRID_FROM_EMAIL=
AUCTOR_PUBLIC_URL=https://auctor.space
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
