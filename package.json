        "drizzle-orm": "0.44.7",
        "lucide-react": "0.468.0",
        "next": "15.5.23",
        "postgres": "3.4.9",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "viem": "2.55.13",
        "wagmi": "2.19.5",
        "zod": "4.4.3"
